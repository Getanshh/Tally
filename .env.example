# ---- Tally connection ----
# Tally's XML port has NO authentication. Keep it on the LAN only; never expose it to the internet.
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_TIMEOUT_MS=15000
# Number of retries for READ requests only (writes are never retried by the transport).
TALLY_READ_RETRIES=2
# Encoding used for request bodies sent to Tally: utf-8 | utf-16le   (VERIFY-ON-TALLY for Gujarati/₹ characters)
TALLY_REQUEST_ENCODING=utf-8

# Company used by read tools when none is given. Must match the Tally company name EXACTLY.
DEFAULT_COMPANY=Baijay International Private Limited TEST

# ---- Local database shared by the MCP server and the approval app ----
DB_PATH=./data/tally-bridge.sqlite

# ---- Write safety (used from Phase 2 onwards; only the desktop approval app ever writes) ----
# Global kill switch. Must be explicitly set to true to allow any posting.
TALLY_WRITE_ENABLED=false
# Comma-separated exact company names that may receive writes. Use the TEST company during development.
# NEVER add the live company ("Baijay International Private Limited") until the owner signs off.
WRITE_ALLOWED_COMPANIES=
# Comma-separated exact Tally voucher type names that may be proposed/posted.
ALLOWED_VOUCHER_TYPES=Purchase Order
# Voucher types that are posted as Optional vouchers (default: all invoice types).
OPTIONAL_VOUCHER_TYPES=Sales,Purchase
# Proposals above this amount (INR) need two different approvers.
SECOND_APPROVAL_THRESHOLD_INR=100000
# Pending proposals older than this become EXPIRED.
PROPOSAL_EXPIRY_HOURS=48
